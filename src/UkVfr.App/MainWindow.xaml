<Window x:Class="UkVfr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UkVfr.App"
        mc:Ignorable="d"
        Title="UK VFR ATC" Height="700" Width="900"
        Background="#1E1E2E">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: Sim data + Pilot menu -->
        <Border Grid.Column="0" Background="#2B2B3D" CornerRadius="8" Padding="12" Margin="0,0,6,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Aerodrome selector -->
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Aerodrome" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                    <ComboBox x:Name="CmbAerodrome" SelectionChanged="OnAerodromeChanged"
                              Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                              FontSize="12" Padding="6,4" />
                </StackPanel>

                <!-- Active unit display -->
                <Border Grid.Row="1" Background="#313244" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                    <TextBlock x:Name="ActiveUnitText" Foreground="#A6E3A1" FontSize="11"
                               TextWrapping="Wrap" Text="No unit selected" />
                </Border>

                <!-- Sim status -->
                <TextBlock Grid.Row="2" Text="Aircraft State"
                           Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,3" />
                <TextBox x:Name="StateTextBox" Grid.Row="3"
                         FontFamily="Consolas" FontSize="10"
                         Foreground="#A6ADC8" Background="Transparent"
                         BorderThickness="0" IsReadOnly="True"
                         TextWrapping="Wrap" Height="150" />

                <!-- Provider status -->
                <TextBlock Grid.Row="4" x:Name="ProviderStatusText"
                           Foreground="#6C7086" FontSize="10"
                           TextWrapping="Wrap" Margin="0,2,0,4" />

                <!-- Pilot menu (fallback input) -->
                <Border Grid.Row="5" Background="#313244" CornerRadius="6" Padding="8" Margin="0,2,0,0">
                    <StackPanel>
                        <TextBlock Text="Pilot Menu" Foreground="#CDD6F4"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button x:Name="BtnInitialCall" Content="Initial Call"
                                Click="OnMenuInitialCall" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnPassMessage" Content="Pass Message"
                                Click="OnMenuPassMessage" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnRequestJoin" Content="Request Join"
                                Click="OnMenuRequestJoin" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnPositionDownwind" Content="Report: Downwind"
                                Click="OnMenuDownwind" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnPositionFinal" Content="Report: Final"
                                Click="OnMenuFinal" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnReadback" Content="Readback"
                                Click="OnMenuReadback" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnRoger" Content="Roger"
                                Click="OnMenuRoger" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnFreqChange" Content="Request Freq Change"
                                Click="OnMenuFreqChange" Style="{StaticResource MenuBtn}" />
                        <Button x:Name="BtnAtis" Content="Request ATIS"
                                Click="OnMenuAtis" Style="{StaticResource MenuBtn}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right panel: ATC transcript -->
        <Border Grid.Column="1" Background="#2B2B3D" CornerRadius="8" Padding="12" Margin="6,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ATC Transcript"
                           Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ListBox x:Name="TranscriptList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <!-- Status bar -->
                <Border Grid.Row="2" Background="#313244" CornerRadius="4" Padding="8,4" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StatusText"
                                   Foreground="#6C7086" FontSize="11"
                                   Text="Disconnected — waiting for SimConnect"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Settings"
                                Click="OnOpenSettings" FontSize="10"
                                Background="#45475A" Foreground="#CDD6F4"
                                BorderThickness="0" Padding="8,3" Cursor="Hand" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background" Value="#45475A" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#585B70" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#6C7086" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
