<Window x:Class="UkVfr.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — UK VFR ATC" Height="520" Width="480"
        Background="#1E1E2E" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
        <StackPanel>
            <!-- SimConnect -->
            <TextBlock Text="SimConnect" Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <CheckBox x:Name="ChkSimulated" Content="Use simulated data (no MSFS required)"
                      Foreground="#A6ADC8" Margin="0,0,0,12" />

            <!-- STT -->
            <TextBlock Text="Speech-to-Text" Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="Whisper model path" Foreground="#6C7086" FontSize="11" />
            <TextBox x:Name="TxtWhisperModel" Style="{StaticResource SettingsTextBox}" />
            <TextBlock Text="OpenAI API key (cloud STT fallback)" Foreground="#6C7086" FontSize="11" Margin="0,6,0,0" />
            <TextBox x:Name="TxtSttApiKey" Style="{StaticResource SettingsTextBox}" />

            <!-- TTS -->
            <TextBlock Text="Text-to-Speech" Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="Preferred provider" Foreground="#6C7086" FontSize="11" />
            <ComboBox x:Name="CmbTtsProvider" Style="{StaticResource SettingsComboBox}" Margin="0,2,0,0">
                <ComboBoxItem Content="ElevenLabs" />
                <ComboBoxItem Content="OpenAI" />
                <ComboBoxItem Content="System (offline)" />
            </ComboBox>
            <TextBlock Text="ElevenLabs API key" Foreground="#6C7086" FontSize="11" Margin="0,6,0,0" />
            <TextBox x:Name="TxtElevenLabsKey" Style="{StaticResource SettingsTextBox}" />
            <TextBlock Text="OpenAI API key (TTS)" Foreground="#6C7086" FontSize="11" Margin="0,6,0,0" />
            <TextBox x:Name="TxtTtsApiKey" Style="{StaticResource SettingsTextBox}" />
            <CheckBox x:Name="ChkRadioFilter" Content="Apply radio band-pass filter"
                      Foreground="#A6ADC8" Margin="0,8,0,0" />

            <!-- Intent Parser -->
            <TextBlock Text="Intent Parser" Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="OpenAI API key (LLM fallback)" Foreground="#6C7086" FontSize="11" />
            <TextBox x:Name="TxtIntentApiKey" Style="{StaticResource SettingsTextBox}" />
            <TextBlock Text="OpenAI model" Foreground="#6C7086" FontSize="11" Margin="0,6,0,0" />
            <TextBox x:Name="TxtIntentModel" Style="{StaticResource SettingsTextBox}" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Click="OnSave" Width="80" Margin="0,0,8,0" Style="{StaticResource SaveBtn}" />
                <Button Content="Cancel" Click="OnCancel" Width="80" Style="{StaticResource CancelBtn}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <Window.Resources>
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#CDD6F4" />
        </Style>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background" Value="#A6E3A1" />
            <Setter Property="Foreground" Value="#1E1E2E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Background" Value="#45475A" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
</Window>
